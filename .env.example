# Frontend Environment Variables

# Local Development
# VITE_API_URL=http://localhost:5000/api

# Production (Render, Railway, Heroku, etc.)
# Set this in your Vercel environment variables to your deployed backend URL
# Example: https://your-portfolio-backend.onrender.com/api
VITE_API_URL=https://your-backend-url-here.onrender.com/api
